---
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const entries = await getCollection('solution');
  return entries
    .filter((e) => !e.data.opencc)
    .map((e) => ({ params: { slug: e.id }, props: { entry: e } }));
}

const { entry } = Astro.props;
return Astro.redirect(`/${entry.data.lang}/oi-notes/${entry.id}/`, 301);
---
