---
import { getCollection } from 'astro:content';
import { SITE_LOCALES, SITE_DISCRIPTION } from '../../config';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { baseSlug } from '../../lib/content-paths';

export async function getStaticPaths() {
  return SITE_LOCALES.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const allPosts = await getCollection('posts');
const postsInLang = allPosts
  .filter((p) => p.data.lang === lang)
  .sort((p, q) => q.data.pubDate.getTime() - p.data.pubDate.getTime());
---

<BaseLayout title="首頁" description={SITE_DISCRIPTION}>
  <h1>EarthMessenger 的博客</h1>
  <ol reversed="true">
    {
      postsInLang.map((post) => {
        return (
          <li>
            <a href={`/${lang}/posts/${baseSlug(post)}`}>{post.data.title}</a>
          </li>
        );
      })
    }
  </ol>
</BaseLayout>
