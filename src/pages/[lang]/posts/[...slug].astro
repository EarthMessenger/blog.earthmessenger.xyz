---
import { render } from 'astro:content';
import PostLayout from '../../../layouts/PostLayout.astro';
import { extractDescription } from '../../../utils';
import { buildEntryPaths } from '../../../lib/content-paths';

export async function getStaticPaths() {
  return buildEntryPaths('posts');
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const description = extractDescription(entry.body);
---

<PostLayout frontmatter={entry.data} linkTags={true} description={description}>
  <Content />
</PostLayout>
