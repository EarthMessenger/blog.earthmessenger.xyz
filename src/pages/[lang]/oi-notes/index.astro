---
import { getCollection } from 'astro:content';
import { SITE_LOCALES, SITE_DISCRIPTION } from '../../../config';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { useTranslations } from '../../../i18n';
import { baseSlug } from '../../../lib/content-paths';

export async function getStaticPaths() {
  return SITE_LOCALES.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const t = useTranslations(lang);

const allPosts = await getCollection('solution');
const postsInLang = allPosts.filter((p) => p.data.lang === lang);

const title = t('nav.solution');
---

<BaseLayout title={title} description={SITE_DISCRIPTION}>
  <h1>{title}</h1>
  <ul>
    {
      postsInLang.map((post) => (
        <li>
          <a
            href={`/${lang}/oi-notes/${baseSlug(post)}`}
          >
            {post.data.title}
          </a>
        </li>
      ))
    }
  </ul>
</BaseLayout>
