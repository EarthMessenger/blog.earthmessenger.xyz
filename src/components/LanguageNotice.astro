---
const { from, to } = Astro.props;
import ColorfulBlockquote from './ColorfulBlockquote.astro';

import { useTranslations, getLangFromUrl } from '../i18n';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const notice = t('language-notice', {
  from: t(from),
  to: t(to),
});
---

{
  (
    <ColorfulBlockquote color="blue">
      <p set:html={notice} />
    </ColorfulBlockquote>
  )
}
